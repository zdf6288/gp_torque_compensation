# ===================== REQUEST =====================

# 当前状态（用于当前补偿）
float32[7] q
float32[7] dq_des_joint
float32[7] ddq_des_joint
float32[7] tau_residual

# 主未来状态（Jacobian 映射后）
float32[7] dq_des_joint_future
float32[7] ddq_des_joint_future

# 未来采样点数量
int32 n_future_samples

# 所有 future samples 的 flatten 一维数组（长度 = n_future_samples * 7）
float32[] dq_future_samples_flat
float32[] ddq_future_samples_flat

